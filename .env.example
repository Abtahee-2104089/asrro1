# Convex deployment selected by `bunx convex dev`.
CONVEX_DEPLOYMENT=

# Public endpoints emitted by the Convex deployment.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Store SITE_URL, TRUSTED_ORIGINS, and BETTER_AUTH_SECRET in the Convex
# deployment environment. SITE_URL is the canonical frontend URL;
# TRUSTED_ORIGINS is an optional comma-separated list for local/preview URLs.
